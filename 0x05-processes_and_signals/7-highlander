#!/usr/bin/env bash
# A Bash script that displays its PID and then waits in a loop
# It prints "I am invincible!!!" when receiving a SIGTERM signal

# Print the Process ID of the script
echo "$$"

# Define the trap: when SIGTERM is received, echo the message
trap 'echo "I am invincible!!!"' SIGTERM

# Infinite loop to keep the script running
while true
do
    echo "To infinity and beyond"
    sleep 2
done
